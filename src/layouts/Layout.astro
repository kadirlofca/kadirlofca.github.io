---
import "../styles/global.css";
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";
import PostHog from "../components/posthog.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  hideFooter?: boolean;
}

const { title, description, ogImage, hideFooter } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <Head title={title} description={description} ogImage={ogImage} />
    <PostHog />
  </head>
  <body>
    <main>
      <slot />
    </main>
    {!hideFooter && <Footer />}
  </body>
</html>
