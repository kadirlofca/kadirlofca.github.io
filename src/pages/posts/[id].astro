---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => data.published);
  return posts.map((post) => ({
    params: { id: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"posts">;
const post = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "long" });

const formatDateRange = (start: Date, end?: Date) => {
  if (!end) return `${formatDate(start)} – Present`;
  if (formatDate(start) === formatDate(end)) return formatDate(end);
  return `${formatDate(start)} – ${formatDate(end)}`;
};

const isYouTube = (url: string) =>
  url.includes("youtube.com") || url.includes("youtu.be");
---

<Layout
  title={post.data.title}
  description={post.data.descriptionHead + post.data.descriptionTail}
  ogImage={`/og/${post.id}.png`}
>
  <button class="back-btn" onclick="history.back()">← Back</button>

  <div class="post-header">
    <div class="post-meta">
      <div class="post-meta-row">
        <span>
          {post.data.role}
          {post.data.role && post.data.organization && " @ "}
          {post.data.organization}
        </span>
        {post.data.location && <span class="post-date">{post.data.location}</span>}
      </div>
    </div>
    <div class="post-title-row">
      <div class="post-title-col">
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-description">{post.data.descriptionHead}{post.data.descriptionTail}</p>
      </div>
      <div class="post-right-col">
        <span class="post-date">{formatDateRange(post.data.date, post.data.endDate)}</span>
        <div class="post-tags">
          {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </div>
    </div>
  </div>

  <script>
    const desc = document.querySelector<HTMLElement>('.post-title-col .post-description');
    const tagsContainer = document.querySelector<HTMLElement>('.post-right-col .post-tags');
    const originalTags = tagsContainer
      ? Array.from(tagsContainer.querySelectorAll<HTMLElement>('.tag'))
      : [];

    function layoutTags() {
      if (!desc || !tagsContainer || originalTags.length === 0) return;

      if (window.innerWidth <= 768) {
        tagsContainer.innerHTML = '';
        originalTags.forEach(tag => tagsContainer.appendChild(tag));
        tagsContainer.style.marginTop = '';
        return;
      }

      const lineHeight = parseFloat(getComputedStyle(desc).lineHeight);
      const rows = Math.max(1, Math.round(desc.getBoundingClientRect().height / lineHeight));
      const perRow = Math.ceil(originalTags.length / rows);

      tagsContainer.innerHTML = '';
      for (let r = 0; r < rows; r++) {
        const slice = originalTags.slice(r * perRow, (r + 1) * perRow);
        if (slice.length === 0) break;
        const rowDiv = document.createElement('div');
        rowDiv.className = 'tag-row';
        slice.forEach(tag => rowDiv.appendChild(tag));
        tagsContainer.appendChild(rowDiv);
      }

      tagsContainer.style.marginTop = '';
      const delta = desc.getBoundingClientRect().top - tagsContainer.getBoundingClientRect().top;
      if (delta > 0) tagsContainer.style.marginTop = delta + 'px';
    }

    document.fonts.ready.then(() => requestAnimationFrame(() => requestAnimationFrame(layoutTags)));

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(layoutTags, 100);
    });
  </script>

  {
    post.data.video && (
      <div class="video-wrapper">
        {isYouTube(post.data.video) ? (
          <iframe src={post.data.video} title={post.data.title} allowfullscreen />
        ) : (
          <video src={post.data.video} controls />
        )}
      </div>
    )
  }

  <div class="prose">
    <Content />
  </div>

  <script is:inline define:vars={{ postId: post.id, postTitle: post.data.title, postTags: post.data.tags, postOrganization: post.data.organization ?? null, postRole: post.data.role ?? null }}>
    window.posthog?.capture('post_viewed', {
      post_id: postId,
      post_title: postTitle,
      post_tags: postTags,
      post_organization: postOrganization,
      post_role: postRole
    });
  </script>
</Layout>
