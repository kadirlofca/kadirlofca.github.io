---
import Layout from "../layouts/Layout.astro";
import ProfileCard from "../components/ProfileCard.astro";
import PhotoCarousel from "../components/PhotoCarousel.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";
import siteData from "../data/site.json";

const allPosts = (await getCollection("posts"))
  .filter((post) => post.data.published)
  .sort((a, b) => {
    const orderDiff = a.data.order - b.data.order;
    if (orderDiff !== 0) return orderDiff;
    const aEnd = a.data.endDate?.getTime() ?? Infinity;
    const bEnd = b.data.endDate?.getTime() ?? Infinity;
    return bEnd - aEnd;
  });

const formatYear = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric" });

const formatDateRange = (start: Date, end?: Date) => {
  const startYear = formatYear(start);
  if (!end) return `${startYear} – Present`;
  const endYear = formatYear(end);
  return startYear === endYear ? startYear : `${startYear} – ${endYear}`;
};

---

<Layout title={siteData.siteTitle} description={siteData.siteDescription} hideFooter>
  <div class="home-layout">
    <aside class="sidebar">
      <div class="sidebar-fixed">
        <ProfileCard />
      </div>
    </aside>
    <div class="entries-column">
    <ul class="posts-list">
      {
        allPosts.map((post) => (
          <li class="post-card">
            <a href={`/posts/${post.id}`}>
              <div class="post-meta">
                {(post.data.role || post.data.organization) && (
                  <div class="post-meta-row">
                    <span>
                      {post.data.role}
                      {post.data.role && post.data.organization && " @ "}
                      {post.data.organization}
                    </span>
                  </div>
                )}
              </div>
              <div class="post-title-row">
                <div class="post-title">{post.data.title}</div>
                <div class="post-date">{post.data.endDate ? formatYear(post.data.endDate) : "Present"}</div>
              </div>
              <div class="post-meta">
              </div>
              <div class="post-description">
                <span class="desc-head">{post.data.descriptionHead}</span><span class="desc-tail">{post.data.descriptionTail}</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
    <PhotoCarousel />
    <Footer />
    </div>
  </div>

<script>
  document.fonts.ready.then(() => {
    requestAnimationFrame(() => {
      const avatar = document.querySelector<HTMLImageElement>('.avatar');
      const postsList = document.querySelector<HTMLUListElement>('.posts-list');
      if (!avatar || !postsList) return;

      // set top padding first
      const avatarRect = avatar.getBoundingClientRect();
      const postsTop = postsList.getBoundingClientRect().top;
      postsList.style.paddingTop = Math.max(0, avatarRect.top - postsTop) + 'px';

      // align last card bottom with bio bottom at max scroll — no scrolling needed
      // derivation: at max scroll, lastCard.bottom = -H_after_lastCard - mainPaddingBottom + innerHeight
      // for this to equal bioBottom: H_after_lastCard = innerHeight - bioBottom - mainPaddingBottom
      requestAnimationFrame(() => {
        const bio = document.querySelector<HTMLElement>('.bio-head') ?? document.querySelector<HTMLElement>('.socials');
        const entriesColumn = document.querySelector<HTMLElement>('.entries-column');
        const footer = document.querySelector<HTMLElement>('.site-footer');
        const mainEl = document.querySelector<HTMLElement>('main');
        if (!bio || !entriesColumn || !footer || !mainEl) return;

        const bioBottom = bio.getBoundingClientRect().bottom;
        const mainPB = parseFloat(getComputedStyle(mainEl).paddingBottom);

        // measure how much the invisible desc-tail overhangs below desc-head in the last card
        const lastCard = document.querySelector<HTMLElement>('.post-card:last-child');
        const lastDescHead = lastCard?.querySelector<HTMLElement>('.desc-head');
        const tailOverhang = (lastCard && lastDescHead)
          ? lastCard.getBoundingClientRect().bottom - lastDescHead.getBoundingClientRect().bottom
          : 0;

        const required = window.innerHeight - bioBottom - mainPB - tailOverhang;
        const footerHeight = footer.getBoundingClientRect().height;
        const extra = required - footerHeight;

        if (extra > 0) {
          entriesColumn.style.paddingBottom = extra + 'px';
        } else {
          const curPT = parseFloat(getComputedStyle(footer).paddingTop);
          footer.style.paddingTop = Math.max(0, curPT + extra) + 'px';
        }
      });
    });
  });
</script>
</Layout>
