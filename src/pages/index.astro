---
import Layout from "../layouts/Layout.astro";
import ProfileCard from "../components/ProfileCard.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";
import siteData from "../data/site.json";

const allPosts = (await getCollection("posts"))
  .filter((post) => post.data.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<Layout title={siteData.siteTitle} description={siteData.siteDescription} hideFooter>
  <div class="home-layout">
    <aside class="sidebar">
      <div class="sidebar-fixed">
        <ProfileCard />
      </div>
    </aside>
    <div class="entries-column">
    <ul class="posts-list">
      {
        allPosts.map((post) => (
          <li class="post-card">
            <a href={`/posts/${post.id}`}>
              <div class="post-title-row">
                <div class="post-title">{post.data.title}</div>
                <div class="post-date">{formatDate(post.data.date)}</div>
              </div>
              <div class="post-meta">
                {(post.data.role || post.data.organization) && (
                  <div class="post-meta-row">
                    <span>
                      {post.data.role}
                      {post.data.role && post.data.organization && " @ "}
                      {post.data.organization}
                    </span>
                    {post.data.location && <span class="post-location">{post.data.location}</span>}
                  </div>
                )}
              </div>
              <div class="post-description">{post.data.description}</div>
            </a>
          </li>
        ))
      }
    </ul>
    <Footer />
    </div>
  </div>

<script>
  document.fonts.ready.then(() => {
    requestAnimationFrame(() => {
      const avatar = document.querySelector<HTMLImageElement>('.avatar');
      const postsList = document.querySelector<HTMLUListElement>('.posts-list');
      if (!avatar || !postsList) return;

      // set top padding first
      const avatarRect = avatar.getBoundingClientRect();
      const postsTop = postsList.getBoundingClientRect().top;
      postsList.style.paddingTop = Math.max(0, avatarRect.top - postsTop) + 'px';

      // wait for reflow, then measure bottom alignment by actually scrolling
      requestAnimationFrame(() => {
        const socials = document.querySelector<HTMLElement>('.socials');
        if (!socials) return;

        const socialsBottom = socials.getBoundingClientRect().bottom;

        window.scrollTo(0, document.body.scrollHeight);
        const lastCard = document.querySelector<HTMLElement>('.post-card:last-child');
        const lastCardBottom = lastCard?.getBoundingClientRect().bottom ?? 0;
        window.scrollTo(0, 0);

        // padding pushes last card up at max scroll: P = lastCardBottom - socialsBottom
        const needed = lastCardBottom - socialsBottom;
        if (needed > 0) postsList.style.paddingBottom = needed + 'px';
      });
    });
  });
</script>
</Layout>
