---
import Layout from "../layouts/Layout.astro";
import ProfileCard from "../components/ProfileCard.astro";
import PhotoCarousel from "../components/PhotoCarousel.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";
import siteData from "../data/site.json";
import BioBlock from "../components/BioBlock.astro";

const allPosts = (await getCollection("posts"))
  .filter((post) => post.data.published)
  .sort((a, b) => {
    const orderDiff = a.data.order - b.data.order;
    if (orderDiff !== 0) return orderDiff;
    const aEnd = a.data.endDate?.getTime() ?? Infinity;
    const bEnd = b.data.endDate?.getTime() ?? Infinity;
    return bEnd - aEnd;
  });

const formatYear = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric" });

const formatDateRange = (start: Date, end?: Date) => {
  const startYear = formatYear(start);
  if (!end) return `${startYear} – Present`;
  const endYear = formatYear(end);
  return startYear === endYear ? startYear : `${startYear} – ${endYear}`;
};

---

<Layout title={siteData.siteTitle} description={siteData.siteDescription} hideFooter>
  <div class="home-layout">
    <aside class="sidebar">
      <div class="sidebar-fixed">
        <ProfileCard />
      </div>
    </aside>
    <div class="entries-column">
      <div class="home-content">
        <ul class="posts-list">
          <li><BioBlock /></li>
          {
            allPosts.map((post) => (
              <li class="post-card">
                <a href={`/posts/${post.id}`}>
                  <div class="post-meta">
                    {(post.data.role || post.data.organization) && (
                      <div class="post-meta-row">
                        <span>
                          {post.data.role}
                          {post.data.role && post.data.organization && " @ "}
                          {post.data.organization}
                        </span>
                      </div>
                    )}
                  </div>
                  <div class="post-title-row">
                    <div class="post-title">{post.data.title}</div>
                    <div class="post-date">{post.data.endDate ? formatYear(post.data.endDate) : "Present"}</div>
                  </div>
                  <div class="post-meta">
                  </div>
                  <div class="post-description">
                    <span class="desc-head">{post.data.descriptionHead}</span><span class="desc-tail">{post.data.descriptionTail}</span>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
        <PhotoCarousel />
        <Footer />
      </div>
      <div class="post-content" style="display:none"></div>
    </div>
  </div>


<script>
  history.scrollRestoration = 'manual';

  const homeContent = document.querySelector<HTMLElement>('.home-content')!;
  const postContent = document.querySelector<HTMLElement>('.post-content')!;
  const entriesColumn = document.querySelector<HTMLElement>('.entries-column')!;
  const savedTitle = document.title;
  let savedScrollY = 0;

  function align() {
    const postsList = document.querySelector<HTMLUListElement>('.posts-list');
    const footer = document.querySelector<HTMLElement>('.site-footer');

    if (window.innerWidth <= 768) {
      if (postsList) postsList.style.paddingTop = '';
      if (entriesColumn) entriesColumn.style.paddingBottom = '';
      return;
    }

    const avatar = document.querySelector<HTMLImageElement>('.avatar');
    const mainEl = document.querySelector<HTMLElement>('main');
    const anchorEl = document.querySelector<HTMLElement>('.socials');

    if (!avatar || !postsList || !anchorEl || !footer || !mainEl) return;

    postsList.style.paddingTop = '';
    entriesColumn.style.paddingBottom = '';

    const avatarRect = avatar.getBoundingClientRect();
    const postsDocTop = postsList.getBoundingClientRect().top + window.scrollY;
    postsList.style.paddingTop = Math.max(0, avatarRect.top - postsDocTop) + 'px';

    const anchorRect = anchorEl.getBoundingClientRect();
    const bioCenter = (anchorRect.top + anchorRect.bottom) / 2;
    const footerH = footer.getBoundingClientRect().height;
    const mainPB = parseFloat(getComputedStyle(mainEl).paddingBottom);
    const extra = window.innerHeight - bioCenter - mainPB - footerH / 2;
    if (extra > 0) entriesColumn.style.paddingBottom = extra + 'px';
  }

  async function navigateToPost(url: string, push = true) {
    const res = await fetch(url);
    const html = await res.text();
    const doc = new DOMParser().parseFromString(html, 'text/html');

    postContent.innerHTML = '';
    for (const sel of ['.back-btn', '.post-header', '.video-wrapper', '.prose']) {
      const el = doc.querySelector(sel);
      if (el) postContent.appendChild(document.adoptNode(el));
    }

    savedScrollY = window.scrollY;
    homeContent.style.display = 'none';
    postContent.style.display = '';
    postContent.style.paddingTop = document.querySelector<HTMLElement>('.posts-list')?.style.paddingTop ?? '';
    window.scrollTo(0, 0);

    if (push) history.pushState({ spa: true, url }, '', url);
    document.title = doc.title;
  }

  function navigateHome(push = true) {
    postContent.style.display = 'none';
    postContent.innerHTML = '';
    homeContent.style.display = '';

    if (push) history.pushState({ spa: false }, '', '/');
    document.title = savedTitle;
    requestAnimationFrame(() => {
      window.scrollTo(0, savedScrollY);
      align();
    });
  }

  window.addEventListener('popstate', (e) => {
    if ((e.state as any)?.spa) {
      navigateToPost((e.state as any).url, false);
    } else {
      navigateHome(false);
    }
  });

  history.replaceState({ spa: false }, '', location.href);

  document.querySelectorAll<HTMLAnchorElement>('.post-card a').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const card = link.closest('.post-card');
      const title = card?.querySelector('.post-title')?.textContent?.trim();
      (window as any).posthog?.capture('entry_clicked', { post_title: title });
      navigateToPost(link.href);
    });
  });

  document.fonts.ready.then(() => requestAnimationFrame(() => requestAnimationFrame(align)));

  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(align, 100);
  });

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') requestAnimationFrame(align);
  });
</script>
</Layout>
