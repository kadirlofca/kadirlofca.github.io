---
import Layout from "../layouts/Layout.astro";
import ProfileCard from "../components/ProfileCard.astro";
import PhotoCarousel from "../components/PhotoCarousel.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";
import siteData from "../data/site.json";
import BioBlock from "../components/BioBlock.astro";
import EndorsedBy from "../components/EndorsedBy.astro";

const allPosts = (await getCollection("posts"))
  .filter((post) => post.data.published)
  .sort((a, b) => {
    const orderDiff = a.data.order - b.data.order;
    if (orderDiff !== 0) return orderDiff;
    const aEnd = a.data.endDate?.getTime() ?? Infinity;
    const bEnd = b.data.endDate?.getTime() ?? Infinity;
    return bEnd - aEnd;
  });

const formatYear = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric" });

---

<Layout title={siteData.siteTitle} description={siteData.siteDescriptionShort} hideFooter>
  <div class="home-layout">
    <aside class="sidebar">
      <div class="sidebar-fixed">
        <ProfileCard />
      </div>
    </aside>
    <div class="entries-column">
      <div class="home-content">
        <h1 class="sr-only">{siteData.siteTitle}</h1>
        <ul class="posts-list">
          <li><BioBlock /></li>
          <li><EndorsedBy /></li>
          {
            allPosts.map((post) => (
              <li class="post-card">
                <a href={`/posts/${post.id}`}>
                  <div class="post-meta">
                    <div class="post-meta-row">
                      {(post.data.role || post.data.organization) && (
                        <span>
                          {post.data.role}
                          {post.data.role && post.data.organization && " @ "}
                          {post.data.organization}
                        </span>
                      )}
                      <div class="post-date post-date--meta">{post.data.endDate ? formatYear(post.data.endDate) : "Present"}</div>
                    </div>
                  </div>
                  <div class="post-title-row">
                    <h2 class="post-title">{post.data.title}</h2>
                    <div class="post-date post-date--title">{post.data.endDate ? formatYear(post.data.endDate) : "Present"}</div>
                  </div>
                  <div class="post-description">
                    <span class="desc-head">{post.data.descriptionHead}</span><span class="desc-tail">{post.data.descriptionTail}</span>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
        <PhotoCarousel />
        <Footer />
      </div>
      <div class="post-content" style="display:none"></div>
    </div>
  </div>


<script>
  history.scrollRestoration = 'manual';

  const homeContent = document.querySelector<HTMLElement>('.home-content')!;
  const postContent = document.querySelector<HTMLElement>('.post-content')!;
  const entriesColumn = document.querySelector<HTMLElement>('.entries-column')!;
  const savedTitle = document.title;
  let savedScrollY = 0;

  function align() {
    const postsList = document.querySelector<HTMLUListElement>('.posts-list');
    const footer = document.querySelector<HTMLElement>('.site-footer');

    if (window.innerWidth <= 768) {
      if (postsList) postsList.style.paddingTop = '';
      if (entriesColumn) entriesColumn.style.paddingBottom = '';
      return;
    }

    const avatar = document.querySelector<HTMLImageElement>('.avatar');
    const mainEl = document.querySelector<HTMLElement>('main');
    const anchorEl = document.querySelector<HTMLElement>('.socials');

    if (!avatar || !postsList || !anchorEl || !footer || !mainEl) return;

    postsList.style.paddingTop = '';
    entriesColumn.style.paddingBottom = '';

    const avatarRect = avatar.getBoundingClientRect();
    const postsDocTop = postsList.getBoundingClientRect().top + window.scrollY;
    postsList.style.paddingTop = Math.max(0, avatarRect.top - postsDocTop) + 'px';

    const anchorRect = anchorEl.getBoundingClientRect();
    const bioCenter = (anchorRect.top + anchorRect.bottom) / 2;
    const footerH = footer.getBoundingClientRect().height;
    const mainPB = parseFloat(getComputedStyle(mainEl).paddingBottom);
    const extra = window.innerHeight - bioCenter - mainPB - footerH / 2;
    if (extra > 0) entriesColumn.style.paddingBottom = extra + 'px';
  }

  const supportsVT = 'startViewTransition' in document;
  let currentPostUrl = '';

  const pageAnnouncer = document.getElementById('page-announcer');

  function announce(msg: string) {
    if (!pageAnnouncer) return;
    pageAnnouncer.textContent = '';
    requestAnimationFrame(() => { pageAnnouncer.textContent = msg; });
  }

  function cssMs(varName: string): number {
    return parseFloat(getComputedStyle(document.documentElement).getPropertyValue(varName)) * 1000;
  }

  function vt(el: HTMLElement | null | undefined, name: string) {
    el?.style.setProperty('view-transition-name', name);
  }
  function clearVT(...els: (HTMLElement | null | undefined)[]) {
    els.forEach(el => el?.style.removeProperty('view-transition-name'));
  }

  async function navigateToPost(url: string, push = true) {
    const card = document.querySelector<HTMLElement>(`.post-card a[href="${url}"]`)?.closest<HTMLElement>('.post-card');
    const cardTitle = card?.querySelector<HTMLElement>('.post-title');
    const cardDesc = card?.querySelector<HTMLElement>('.post-description');

    const res = await fetch(url);
    const html = await res.text();
    const doc = new DOMParser().parseFromString(html, 'text/html');

    savedScrollY = window.scrollY;
    currentPostUrl = url;

    // Old state: name the card elements (currently visible)
    vt(cardTitle, 'vt-title');
    vt(cardDesc, 'vt-desc');

    const swap = () => {
      postContent.innerHTML = '';
      for (const sel of ['.back-btn', '.post-header', '.video-wrapper', '.prose']) {
        const el = doc.querySelector(sel);
        if (el) postContent.appendChild(document.adoptNode(el));
      }
      // Clear from card (now hidden), name the adopted elements (new state)
      clearVT(cardTitle, cardDesc);
      vt(postContent.querySelector<HTMLElement>('h1.post-title'), 'vt-title');
      vt(postContent.querySelector<HTMLElement>('.post-description'), 'vt-desc');
      vt(postContent.querySelector<HTMLElement>('.prose'), 'vt-prose');

      homeContent.style.display = 'none';
      postContent.style.display = '';
      postContent.style.paddingTop = document.querySelector<HTMLElement>('.posts-list')?.style.paddingTop ?? '';
      window.scrollTo(0, 0);
    };

    if (supportsVT) {
      await (document as any).startViewTransition(swap).finished;
    } else {
      swap();
    }

    if (push) history.pushState({ spa: true, url }, '', url);
    document.title = doc.title;
    announce(doc.title);
  }

  async function navigateHome(push = true) {
    const card = document.querySelector<HTMLElement>(`.post-card a[href="${currentPostUrl}"]`)?.closest<HTMLElement>('.post-card');
    const cardTitle = card?.querySelector<HTMLElement>('.post-title');
    const cardDesc  = card?.querySelector<HTMLElement>('.post-description');
    const postTitle = postContent.querySelector<HTMLElement>('h1.post-title');
    const postDesc  = postContent.querySelector<HTMLElement>('.post-description');
    const prose     = postContent.querySelector<HTMLElement>('.prose');

    // Start prose fade while capturing FIRST positions
    if (prose) { prose.style.transition = 'opacity var(--transition-exit) ease'; prose.style.opacity = '0'; }
    const postTitleRect = postTitle?.getBoundingClientRect();
    const postDescRect  = postDesc?.getBoundingClientRect();

    await new Promise<void>(r => setTimeout(r, cssMs('--transition-exit')));

    // Swap: hide post, reveal home invisible so it can fade in
    postContent.style.display  = 'none';
    homeContent.style.opacity  = '0';
    homeContent.style.display  = '';
    align();
    window.scrollTo(0, savedScrollY);

    // Capture LAST positions
    const cardTitleRect = cardTitle?.getBoundingClientRect();
    const cardDescRect  = cardDesc?.getBoundingClientRect();

    // FLIP invert: place card elements at post positions
    if (cardTitle && postTitleRect && cardTitleRect)
      cardTitle.style.transform = `translate(${postTitleRect.left - cardTitleRect.left}px,${postTitleRect.top - cardTitleRect.top}px)`;
    if (cardDesc && postDescRect && cardDescRect)
      cardDesc.style.transform  = `translate(${postDescRect.left - cardDescRect.left}px,${postDescRect.top - cardDescRect.top}px)`;

    void cardTitle?.offsetWidth; // force reflow before animating

    // Play: fade in everything + FLIP translate title/desc simultaneously
    await new Promise<void>(r => requestAnimationFrame(() => r()));
    const ease = 'cubic-bezier(0.2, 0, 0, 1)';
    homeContent.style.transition = 'opacity var(--transition-enter) ease';
    homeContent.style.opacity    = '1';
    if (cardTitle) { cardTitle.style.transition = `transform var(--transition-enter) ${ease}`; cardTitle.style.transform = ''; }
    if (cardDesc)  { cardDesc.style.transition  = `transform var(--transition-enter) ${ease}`; cardDesc.style.transform  = ''; }

    await new Promise<void>(r => setTimeout(r, cssMs('--transition-enter')));

    homeContent.style.transition = '';
    homeContent.style.opacity    = '';
    if (cardTitle) cardTitle.style.transition = '';
    if (cardDesc)  cardDesc.style.transition  = '';
    postContent.innerHTML = '';

    if (push) history.pushState({ spa: false }, '', '/');
    document.title = savedTitle;
    announce(savedTitle);
  }

  window.addEventListener('popstate', (e) => {
    if ((e.state as any)?.spa) navigateToPost((e.state as any).url, false);
    else navigateHome(false);
  });

  history.replaceState({ spa: false }, '', location.href);

  document.querySelectorAll<HTMLAnchorElement>('.post-card a').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const card = link.closest('.post-card');
      const title = card?.querySelector('.post-title')?.textContent?.trim();
      (window as any).posthog?.capture('entry_clicked', { post_title: title });
      navigateToPost(link.getAttribute('href')!);
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('.endorsement-name').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      (window as any).posthog?.capture('endorsement_clicked', { endorser_name: link.textContent?.trim() });
      navigateToPost(link.getAttribute('href')!);
    });
  });

  document.fonts.ready.then(() => requestAnimationFrame(() => requestAnimationFrame(align)));

  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(align, 100);
  });

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') requestAnimationFrame(align);
  });
</script>
</Layout>
