---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import siteData from "../data/site.json";

const allPosts = (await getCollection("posts"))
  .filter((post) => post.data.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<Layout title={siteData.siteTitle} description={siteData.siteDescription}>
  <ul class="posts-list">
    {
      allPosts.map((post) => (
        <li class="post-card">
          <a href={`/posts/${post.id}`}>
            <div class="post-title">{post.data.title}</div>
            <div class="post-meta">
              <div>{formatDate(post.data.date)}</div>
              {(post.data.role || post.data.organization) && (
                <div>
                  {post.data.role}
                  {post.data.role && post.data.organization && " @ "}
                  {post.data.organization}
                  {post.data.location && ` — ${post.data.location}`}
                </div>
              )}
              <div class="post-tags">
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
            <div class="post-description">{post.data.description}</div>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
