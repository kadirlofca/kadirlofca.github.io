---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const endorsements = await getCollection("endorsements", ({ data }) => data.published);
  return endorsements.map((endorsement) => ({
    params: { id: endorsement.id },
    props: endorsement,
  }));
}

type Props = CollectionEntry<"endorsements">;
const endorsement = Astro.props;
const { Content } = await render(endorsement);
const { name, relationship, year } = endorsement.data;
---

<Layout
  title={`Endorsed by ${name} | Kadir Lofca`}
  description={`${name}, ${relationship} — endorsement of Kadir Lofca.`}
>
  <button class="back-btn" onclick="history.back()">← Back</button>

  <div class="post-header">
    <div class="post-title-row">
      <h1 class="post-title">{name}'s Endorsement</h1>
      <div class="post-right-col">
        <div class="post-date-location">
          <span class="post-date">{year}</span>
        </div>
      </div>
    </div>
    <p class="post-description">{relationship}</p>
  </div>

  <div class="prose">
    <Content />
    <footer class="endorsement-citation">
      — {name}
    </footer>
  </div>

  <script is:inline define:vars={{ endorserId: endorsement.id, endorserName: name }}>
    window.posthog?.capture('endorsement_viewed', {
      endorser_id: endorserId,
      endorser_name: endorserName,
    });
  </script>
</Layout>

<style>
  .endorsement-citation {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
    color: var(--muted);
    font-style: normal;
  }
</style>
