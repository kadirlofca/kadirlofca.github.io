---
import userPersonalData from "../data/user-personal.json";
import userContactData from "../data/user-contact.json";
---

<header class="site-header">
  <a href="/" class="site-name">{userPersonalData.userName}</a>
  <nav>
    {
      userContactData.userSocials.map((social) => (
        <a href={social.url} target="_blank" rel="noopener noreferrer">
          {social.title}
        </a>
      ))
    }
    <a href={`mailto:${userContactData.userEmail.trim()}`}>Email</a>
  </nav>
</header>

<script is:inline>
  document.querySelector('.site-header nav')?.addEventListener('click', function(e) {
    var target = e.target;
    if (target && target.tagName === 'A') {
      window.posthog?.capture('social_link_clicked', {
        link_title: target.textContent?.trim()
      });
    }
  });
</script>
