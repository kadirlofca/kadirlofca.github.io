---
import userData from "../data/user-personal.json";
const { bio } = userData;
---

<div class="bio-block">
  <p class="post-description">{bio}</p>
</div>

<style>
  .bio-block {
    margin-top: -0.45rem;
    margin-bottom: 4rem;
  }

  .post-description {
    white-space: pre-wrap;
    margin-top: 0;
  }
</style>
