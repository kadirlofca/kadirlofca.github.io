---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const photos = Object.values(photoModules).map(m => m.default);
---

{photos.length > 0 && (
  <>
    <div class="photo-carousel">
      <div class="carousel-fade carousel-fade-left"></div>
      <div class="carousel-track">
        {photos.map((photo) => (
          <Image class="carousel-photo" src={photo} width={540} height={540} alt="" decoding="async" loading="eager" />
        ))}
      </div>
      <div class="carousel-fade carousel-fade-right"></div>
    </div>

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lightbox-close" id="lightbox-close" aria-label="Close">✕</button>
      <img class="lightbox-img" id="lightbox-img" src="" alt="" />
    </div>
  </>
)}

<style>
  .photo-carousel {
    overflow: hidden;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-top: 9rem;
    position: relative;
  }

  .carousel-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 120px;
    z-index: 1;
    pointer-events: none;
  }

  .carousel-fade-left {
    left: 0;
    background: linear-gradient(to right, var(--bg), transparent);
  }

  .carousel-fade-right {
    right: 0;
    background: linear-gradient(to left, var(--bg), transparent);
  }

  .carousel-track {
    display: flex;
    gap: 1rem;
    width: max-content;
    animation: carousel-scroll var(--duration, 40s) linear infinite;
    will-change: transform;
  }

  .carousel-photo {
    width: 120px;
    height: 120px;
    max-width: none;
    object-fit: cover;
    border-radius: 50%;
    flex-shrink: 0;
    cursor: pointer;
  }

  @keyframes carousel-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(var(--scroll-distance, -50%)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track { animation: none; }
  }

  @media (max-width: 768px) {
    .photo-carousel {
      margin-top: 13rem;
      margin-bottom: 2rem;
      margin-left: -1rem;
      margin-right: -1rem;
      width: calc(100% + 2rem);
      max-width: calc(100% + 2rem);
    }

    .carousel-fade { display: none; }

    .carousel-photo {
      width: 270px;
      height: 270px;
      border-radius: 16px;
    }
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    background: var(--overlay);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-fade);
    z-index: 1000;
  }

  .lightbox.open {
    opacity: 1;
    pointer-events: all;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    border-radius: 8px;
    object-fit: contain;
  }

  .lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
    line-height: 1;
    opacity: 0.7;
    transition: opacity var(--transition-color);
  }

  .lightbox-close:hover {
    opacity: 1;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.photo-carousel').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('.carousel-track');
    if (!track) return;

    const origItems = Array.from(track.children) as HTMLElement[];
    if (origItems.length === 0) return;

    const gap = parseFloat(getComputedStyle(track).gap) || 16;
    const photoWidth = origItems[0].getBoundingClientRect().width || 120;
    const setWidth = origItems.length * (photoWidth + gap);

    const containerWidth = carousel.getBoundingClientRect().width;
    while (track.getBoundingClientRect().width < containerWidth + setWidth) {
      origItems.forEach(item => track.appendChild(item.cloneNode(true)));
    }

    const duration = setWidth / 22.5;
    track.style.setProperty('--scroll-distance', `-${setWidth}px`);
    track.style.setProperty('--duration', `${duration}s`);

    const anim = track.getAnimations()[0];
    if (anim) {
      carousel.addEventListener('mouseenter', () => { anim.playbackRate = 0.5; });
      carousel.addEventListener('mouseleave', () => { anim.playbackRate = 1; });

      const observer = new IntersectionObserver(
        ([entry]) => { entry.isIntersecting ? anim.play() : anim.pause(); },
        { threshold: 0 }
      );
      observer.observe(carousel);
    }
  });

  // Lightbox
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightbox-close');

  function openLightbox(src: string) {
    lightboxImg.src = src;
    lightbox?.classList.add('open');
    lightbox?.removeAttribute('aria-hidden');
    document.body.style.overflow = 'hidden';
    window.posthog?.capture('photo_opened');
  }

  function closeLightbox() {
    lightbox?.classList.remove('open');
    lightbox?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('carousel-photo')) {
      openLightbox((target as HTMLImageElement).src);
    }
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
