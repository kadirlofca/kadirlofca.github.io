---
import { Image } from 'astro:assets';
import userContact from "../data/user-contact.json";
import USER_PICTURE from "../../public/user-picture.jpeg";

const { userEmail, userSocials } = userContact;
const email = userEmail.trim();
const linkedin = userSocials.find((s) => s.title === "LinkedIn");
const github = userSocials.find((s) => s.title === "GitHub");
---

<div class="profile-card">
  <Image class="avatar" src={USER_PICTURE} width={584} height={584} format="avif" quality={80} alt="Profile picture" fetchpriority="high" loading="eager" />
  <div class="contact">
    <a href={`mailto:${email}`} class="email-link">{email}</a>
    <div class="socials">
      {linkedin && <a href={linkedin.url} target="_blank" rel="noopener noreferrer">LinkedIn</a>}
      {linkedin && github && <span class="separator" aria-hidden="true">·</span>}
      {github && <a href={github.url} target="_blank" rel="noopener noreferrer">GitHub</a>}
    </div>
  </div>
</div>

<style>
  .profile-card {
    width: 270px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
    text-align: center;
  }

  .avatar {
    width: 243px;
    height: 243px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .contact {
    width: 270px;
    font-size: 1rem;
  }

  .email-link {
    display: block;
    padding: 0.4rem 0;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    font-weight: 300;
  }

  .email-link:hover {
    color: inherit;
    text-decoration: underline;
  }

  .socials {
    display: flex;
    width: 270px;
    font-size: 1rem;
    gap: 0.4rem;
    align-items: center;
    justify-content: center;
  }

  .separator {
    color: var(--secondary);
  }

  .socials a {
    padding: 0.5rem 0.25rem;
    color: var(--fg);
    text-decoration: none;
    white-space: nowrap;
  }

  .socials a:hover {
    color: var(--fg);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .profile-card {
      width: min(100%, 324px);
    }

    .avatar {
      width: min(90%, 292px);
      height: min(90%, 292px);
    }

    .contact,
    .socials {
      width: min(100%, 324px);
    }
  }
</style>

<script>
  document.fonts.ready.then(() => {
    const avatar = document.querySelector<HTMLImageElement>('.avatar');
    const emailLink = document.querySelector<HTMLAnchorElement>('.email-link');
    if (!avatar || !emailLink) return;

    const targetWidth = avatar.getBoundingClientRect().width;
    if (targetWidth <= 0) return;

    function measureText() {
      const probe = document.createElement('span');
      probe.style.cssText = 'position:absolute;white-space:nowrap;visibility:hidden;pointer-events:none;';
      probe.textContent = emailLink!.textContent;
      emailLink!.appendChild(probe);
      const w = probe.getBoundingClientRect().width;
      emailLink!.removeChild(probe);
      return w;
    }

    const w1 = measureText();
    if (w1 <= 0) return;
    emailLink.style.fontSize = (parseFloat(getComputedStyle(emailLink).fontSize) * targetWidth / w1) + 'px';

    const w2 = measureText();
    if (w2 > 0) {
      emailLink.style.fontSize = (parseFloat(getComputedStyle(emailLink).fontSize) * targetWidth / w2) + 'px';
    }
  });

  document.querySelector('.email-link')?.addEventListener('click', () => {
    window.posthog?.capture('email_link_clicked');
  });

  document.querySelectorAll('.socials a').forEach((link) => {
    link.addEventListener('click', () => {
      window.posthog?.capture('social_link_clicked', {
        link_title: link.textContent?.trim(),
        source: 'profile_card'
      });
    });
  });
</script>

