---
import userContact from "../data/user-contact.json";
import userData from "../data/user-personal.json";
import USER_PICTURE from "../../public/user-picture.jpeg";

const { userEmail, userSocials } = userContact;
const { bioHead, bioTail } = userData;
const picture = USER_PICTURE.src;
const email = userEmail.trim();
const linkedin = userSocials.find((s) => s.title === "LinkedIn");
const github = userSocials.find((s) => s.title === "GitHub");
---

<div class="profile-card">
  <img class="avatar" src={picture} alt="Profile picture" />
  <div class="contact">
    <a href={`mailto:${email}`} class="email-link">{email}</a>
    <div class="socials">
      {linkedin && <a href={linkedin.url} target="_blank" rel="noopener noreferrer">LinkedIn</a>}
      {linkedin && github && <span class="separator">·</span>}
      {github && <a href={github.url} target="_blank" rel="noopener noreferrer">GitHub</a>}
    </div>
    {bioHead && <p class="bio"><span class="bio-head">{bioHead}</span>{' '}<span class="bio-tail">{bioTail}</span></p>}
  </div>
</div>

<style>
  .profile-card {
    width: 243px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
    text-align: center;
  }

  .avatar {
    width: 243px;
    height: 243px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .contact {
    width: 243px;
    font-size: 1rem;
  }

  .email-link {
    display: block;
    margin-bottom: 0.3rem;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    font-weight: 300;
  }

  .email-link:hover {
    color: inherit;
    text-decoration: underline;
  }

  .socials {
    display: flex;
    width: 243px;
    font-size: 1rem;
    gap: 0.4rem;
    align-items: center;
    justify-content: center;
  }

  .separator {
    color: var(--secondary);
  }

  .socials a {
    color: var(--secondary);
    text-decoration: none;
    white-space: nowrap;
  }

  .socials a:hover {
    color: var(--secondary);
    text-decoration: underline;
  }

  .bio {
    margin: 2rem 0 0;
    font-size: 0.8rem;
    color: var(--secondary);
    line-height: 1.4;
    width: 243px;
    text-align: left;
  }


  .bio-tail {
    transition: opacity var(--transition-fade);
  }

  @media (max-width: 768px) {
    .socials {
      justify-content: center;
    }

    .bio {
      margin-top: 1rem;
      font-size: 0.85rem;
      word-spacing: normal;
      text-align: center;
    }

    .bio-tail {
      display: none;
    }
  }
</style>

<script>
  document.fonts.ready.then(() => {
    // Bio tail line-by-line opacity: 0.5 at top → 0 at midway
    const bioTail = document.querySelector<HTMLElement>('.bio-tail');
    if (bioTail) {
      const text = bioTail.textContent ?? '';
      const words = text.trim().split(/\s+/).filter(Boolean);

      bioTail.innerHTML = words.map(w => `<span>${w}</span>`).join(' ');

      requestAnimationFrame(() => requestAnimationFrame(() => {
        const wordEls = Array.from(bioTail.querySelectorAll<HTMLElement>('span'));
        const lineMap = new Map<number, string[]>();
        for (const el of wordEls) {
          const top = Math.round(el.getBoundingClientRect().top);
          if (!lineMap.has(top)) lineMap.set(top, []);
          lineMap.get(top)!.push(el.textContent ?? '');
        }

        const lines = Array.from(lineMap.values());
        const n = lines.length;
        bioTail.innerHTML = '';
        lines.forEach((group, i) => {
          if (i > 0) bioTail.appendChild(document.createTextNode(' '));
          const span = document.createElement('span');
          span.className = 'bio-line';
          const opacity = Math.max(0, 0.4 - 2 * i / n);
          const blur = 1 + Math.max(0, (0.4 - opacity) / 0.4 * 2);
          span.style.setProperty('--line-opacity', opacity.toFixed(3));
          span.style.setProperty('--line-blur', blur.toFixed(2) + 'px');
          span.textContent = group.join(' ');
          bioTail.appendChild(span);
        });

        document.dispatchEvent(new CustomEvent('bio-ready'));
      }));
    }

    // Email width fitting
    const avatar = document.querySelector<HTMLImageElement>('.avatar');
    const emailLink = document.querySelector<HTMLAnchorElement>('.email-link');
    if (!avatar || !emailLink) return;

    const targetWidth = avatar.getBoundingClientRect().width;
    if (targetWidth <= 0) return;

    function measureText() {
      const probe = document.createElement('span');
      probe.style.cssText = 'position:absolute;white-space:nowrap;visibility:hidden;pointer-events:none;';
      probe.textContent = emailLink!.textContent;
      emailLink!.appendChild(probe);
      const w = probe.getBoundingClientRect().width;
      emailLink!.removeChild(probe);
      return w;
    }

    const w1 = measureText();
    if (w1 <= 0) return;
    emailLink.style.fontSize = (parseFloat(getComputedStyle(emailLink).fontSize) * targetWidth / w1) + 'px';

    const w2 = measureText();
    if (w2 > 0) {
      emailLink.style.fontSize = (parseFloat(getComputedStyle(emailLink).fontSize) * targetWidth / w2) + 'px';
    }
  });
</script>

