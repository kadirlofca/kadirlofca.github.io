---
import userPersonalData from "../data/user-personal.json";
---

<footer class="site-footer">
  <span>{userPersonalData.userName} · Raleigh, NC</span>
  <div class="footer-links">
    <a href="https://instagram.com/kadirlofca" target="_blank" rel="noopener noreferrer">Instagram</a>
    <span>·</span>
    <a href="/rss.xml">RSS</a>
  </div>
</footer>

<script is:inline>
  document.querySelector('.site-footer .footer-links')?.addEventListener('click', function(e) {
    var target = e.target;
    if (!target || target.tagName !== 'A') return;
    var href = target.getAttribute('href') || '';
    if (href.includes('rss')) {
      window.posthog?.capture('rss_link_clicked');
    } else {
      window.posthog?.capture('social_link_clicked', {
        link_title: target.textContent?.trim()
      });
    }
  });
</script>
